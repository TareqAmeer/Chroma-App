{
  "name": "chromasmith",
  "version": "1.0.0",
  "description": "Chromasmith — offline film-emulation photo editor (iOS shell wraps the single-file web app)",
  "private": true,
  "scripts": {
    "postinstall": "patch-package && git config core.hooksPath githooks || true",
    "build:www": "./build-ios.sh",
    "sync": "./build-ios.sh && npx cap sync ios",
    "export:test": "node test/export_harness.mjs",
    "export:golden": "node test/export_harness.mjs --golden",
    "video:test": "node test/video_harness.mjs",
    "lint:ai": "node test/lint_ai_origin.mjs",
    "lint:formats": "node test/lint_formats.mjs",
    "lint:library-content": "node test/lint_library_content.mjs",
    "mask:test": "node test/mask_raster.mjs",
    "wireframe:test": "node test/wireframe_inventory.mjs",
    "wireframe:icons": "node test/wireframe_inventory.mjs --icons-baseline",
    "behaviour:test": "playwright test --config=playwright.config.mjs",
    "ui:test": "node test/ui_audit.mjs",
    "ui:baseline": "node test/ui_audit.mjs --baseline",
    "library:responsive-test": "node test/library_responsive_qa.mjs",
    "editor:wireframe-test": "node test/editor_wireframe_diff.mjs",
    "editor:inventory": "node test/editor_wireframe_inventory.mjs",
    "editor:inventory-icons": "node test/editor_wireframe_inventory.mjs --icons-baseline",
    "editor:responsive-test": "node test/editor_responsive_qa.mjs",
    "visual:test": "node test/visual_baseline.mjs",
    "visual:baseline": "node test/visual_baseline.mjs --baseline",
    "visual:scorecard": "node test/visual_scorecard.mjs",
    "perf:test": "node test/perf_bench.mjs",
    "perf:baseline": "node test/perf_bench.mjs --baseline",
    "scorecard": "if [ -x .calibvenv/bin/python3 ]; then .calibvenv/bin/python3 calib/export_scorecard.py; else python3 calib/export_scorecard.py; fi",
    "test": "npm run lint:ai && npm run lint:formats && npm run export:test && npm run scorecard && npm run mask:test && npm run perf:test && npm run ui:test && npm run lib:test && npm run editor:gates",
    "test:ui": "npm run lint:ai && npm run lint:formats && npm run lint:library-content && npm run wireframe:test && npm run library:responsive-test && npm run mask:test && npm run perf:test && npm run ui:test && npm run lib:test && npm run editor:gates",
    "lib:test": "node test/library_perf.mjs",
    "preview": "node test/preview_server.mjs",
    "editor:coverage": "node test/editor_coverage.mjs",
    "editor:snap-check": "node test/editor_snap_lists_check.mjs",
    "editor:html-check": "node test/editor_html_validity_check.mjs",
    "editor:self-reschedule-check": "node test/editor_self_reschedule_check.mjs",
    "editor:native-gate-check": "node test/editor_native_gate_check.mjs",
    "editor:keyboard-check": "node test/editor_keyboard_check.mjs",
    "editor:webkit-smoke": "node test/editor_webkit_smoke.mjs",
    "editor:undo-stress": "node test/editor_undo_stress.mjs",
    "editor:session-roundtrip": "node test/editor_session_roundtrip.mjs",
    "editor:fast-check": "node test/editor_snap_lists_check.mjs && node test/editor_html_validity_check.mjs",
    "editor:token-check": "node test/editor_token_check.mjs",
    "editor:gates": "node test/editor_gates.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/share": "^8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@playwright/test": "^1.63.0",
    "patch-package": "^8.0.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.48.0",
    "pngjs": "^7.0.0"
  }
}
