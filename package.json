{
  "name": "chromasmith",
  "version": "1.0.0",
  "description": "Chromasmith — offline film-emulation photo editor (iOS shell wraps the single-file web app)",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "build:www": "./build-ios.sh",
    "sync": "./build-ios.sh && npx cap sync ios",
    "export:test": "node test/export_harness.mjs",
    "export:golden": "node test/export_harness.mjs --golden",
    "video:test": "node test/video_harness.mjs",
    "lint:ai": "node test/lint_ai_origin.mjs",
    "mask:test": "node test/mask_raster.mjs",
    "ui:test": "node test/ui_audit.mjs",
    "ui:baseline": "node test/ui_audit.mjs --baseline",
    "perf:test": "node test/perf_bench.mjs",
    "perf:baseline": "node test/perf_bench.mjs --baseline",
    "scorecard": "if [ -x .calibvenv/bin/python3 ]; then .calibvenv/bin/python3 calib/export_scorecard.py; else python3 calib/export_scorecard.py; fi",
    "test": "npm run lint:ai && npm run export:test && npm run scorecard && npm run mask:test && npm run perf:test && npm run ui:test"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/share": "^8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "patch-package": "^8.0.1",
    "playwright": "^1.48.0"
  }
}
