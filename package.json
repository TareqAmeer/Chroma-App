{
  "name": "chromasmith",
  "version": "1.2.8",
  "description": "Chromasmith \u2014 offline film-emulation photo editor (iOS shell wraps the single-file web app)",
  "private": true,
  "scripts": {
    "postinstall": "patch-package && git config core.hooksPath tools/githooks || true",
    "build:www": "./build-ios.sh",
    "sync": "./build-ios.sh && npx cap sync ios",
    "export:test": "node test/export_harness.mjs",
    "export:golden": "node test/export_harness.mjs --golden",
    "video:test": "node test/video_harness.mjs",
    "lint:ai": "node test/lint_ai_origin.mjs",
    "lint:formats": "node test/lint_formats.mjs",
    "lint:library-content": "node test/lint_library_content.mjs",
    "mask:test": "node test/mask_raster.mjs",
    "mask:refinement-math": "node test/mask_refinement_math.mjs",
    "wireframe:test": "node test/wireframe_inventory.mjs",
    "wireframe:icons": "node test/wireframe_inventory.mjs --icons-baseline",
    "behaviour:test": "playwright test --config=playwright.config.mjs",
    "ui:test": "node test/ui_audit.mjs",
    "ui:baseline": "node test/ui_audit.mjs --baseline",
    "library:responsive-test": "node test/library_responsive_qa.mjs",
    "library:photo-activity-test": "node test/library_photo_activity.mjs",
    "library:scroll-anchor-test": "node test/library_scroll_anchor.mjs",
    "library:unified-view-test": "node test/library_unified_view.mjs",
    "library:job-history-test": "node test/library_job_history.mjs",
    "library:batch-test": "node --test --test-isolation=none test/recipe_batch.mjs && node test/recipe_batch_ui.mjs",
    "editor:wireframe-test": "node test/editor_wireframe_diff.mjs",
    "editor:inventory": "node test/editor_wireframe_inventory.mjs",
    "editor:inventory-icons": "node test/editor_wireframe_inventory.mjs --icons-baseline",
    "editor:responsive-test": "node test/editor_responsive_qa.mjs",
    "visual:test": "node test/visual_baseline.mjs",
    "visual:baseline": "node test/visual_baseline.mjs --baseline",
    "visual:scorecard": "node test/visual_scorecard.mjs",
    "perf:test": "node test/perf_bench.mjs",
    "perf:baseline": "node test/perf_bench.mjs --baseline",
    "scorecard": "node tools/scripts/run-python.mjs tools/calib/export_scorecard.py",
    "test": "npm run lint:ai && npm run lint:formats && npm run tokens:gates && npm run export:test && npm run scorecard && npm run mask:test && npm run perf:test && npm run ui:test && npm run lib:test && npm run editor:gates",
    "test:ui": "npm run lint:ai && npm run lint:formats && npm run lint:library-content && npm run tokens:gates && npm run wireframe:test && npm run library:responsive-test && npm run mask:test && npm run perf:test && npm run ui:test && npm run lib:test && npm run editor:gates",
    "lib:test": "node test/library_photo_activity.mjs && node test/library_scroll_anchor.mjs && node test/library_unified_view.mjs && node test/library_perf.mjs && node test/reveal_timing.mjs && npm run library:batch-test",
    "reveal:test": "node test/reveal_timing.mjs",
    "preview": "node test/preview_server.mjs",
    "editor:coverage": "node test/editor_coverage.mjs",
    "editor:snap-check": "node test/editor_snap_lists_check.mjs",
    "editor:html-check": "node test/editor_html_validity_check.mjs",
    "editor:self-reschedule-check": "node test/editor_self_reschedule_check.mjs",
    "editor:native-gate-check": "node test/editor_native_gate_check.mjs",
    "editor:keyboard-check": "node test/editor_keyboard_check.mjs",
    "shortcut:registry-test": "node test/shortcut_registry.mjs",
    "control:units-test": "node test/control_unit_labels.mjs",
    "history:hover-test": "node test/history_hover_preview.mjs",
    "editor:webkit-smoke": "node test/editor_webkit_smoke.mjs",
    "editor:undo-stress": "node test/editor_undo_stress.mjs",
    "editor:session-roundtrip": "node test/editor_session_roundtrip.mjs",
    "editor:fuzz-input": "node test/editor_fuzz_input.mjs",
    "editor:canvas-resize-leak": "node test/editor_canvas_resize_leak.mjs",
    "editor:offline-check": "node test/editor_offline_check.mjs",
    "editor:crosstab-check": "node test/editor_crosstab_check.mjs",
    "editor:axe-check": "node test/editor_axe_check.mjs",
    "editor:fast-check": "node test/editor_snap_lists_check.mjs && node test/editor_html_validity_check.mjs",
    "editor:token-check": "node test/editor_token_check.mjs",
    "editor:icon-check": "node test/editor_icon_check.mjs",
    "editor:token-drift-report": "node test/editor_token_drift_report.mjs",
    "editor:motion-token-check": "node test/editor_motion_token_check.mjs",
    "editor:hover-focus-matrix": "node test/editor_hover_focus_matrix.mjs",
    "editor:forced-colors-check": "node test/editor_forced_colors_check.mjs",
    "editor:empty-error-states": "node test/editor_empty_error_states.mjs",
    "editor:pan-check": "node test/editor_pan_check.mjs",
    "editor:zoom-check": "node test/editor_zoom_check.mjs",
    "editor:long-string-check": "node test/editor_long_string_check.mjs",
    "editor:hidpi-check": "node test/editor_hidpi_check.mjs",
    "editor:cvd-check": "node test/editor_cvd_check.mjs",
    "editor:surface-coverage": "node test/surface_coverage_check.mjs",
    "editor:gates": "node test/editor_gates.mjs",
    "editor:gates:visual": "node test/editor_gates.mjs --only=visual,layout,render",
    "editor:gates:tokens": "node test/editor_gates.mjs --only=tokens",
    "editor:gates:a11y": "node test/editor_gates.mjs --only=a11y",
    "editor:gates:structural": "node test/editor_gates.mjs --only=structural",
    "editor:gates:behavior": "node test/editor_gates.mjs --only=behavior",
    "tokens:check": "node tools/scripts/build-tokens.mjs --check",
    "tokens:verify": "node tools/scripts/run-python.mjs design/verify_tokens.py",
    "tokens:gates": "npm run tokens:check && npm run tokens:verify && node tools/scripts/check-kinetic-tokens.mjs",
    "components:build": "node tools/scripts/build-component-registry.mjs && node test/component_runtime_check.mjs",
    "components:check": "node tools/scripts/build-component-registry.mjs --check && node test/component_runtime_check.mjs --check && node tools/scripts/component-visuals-check.mjs",
    "components:contracts:scaffold": "node tools/scripts/scaffold-component-contracts.mjs",
    "components:contracts:check": "node tools/scripts/scaffold-component-contracts.mjs --check",
    "reference:spec:validate": "node tools/scripts/validate-reference-spec.mjs",
    "reference:spec:validate:all": "node tools/scripts/validate-reference-spec.mjs --all",
    "reference:measure": "node tools/scripts/measure-ui-reference.mjs",
    "reference:compare": "node tools/scripts/measure-ui-reference.mjs --compare",
    "masks:inventory": "node test/panel_extract.mjs --section=local && node test/mask_inventory_check.mjs",
    "stop-hook:test": "node --test test/stop_editor_gate_check.mjs",
    "native:contract": "node test/native_contract.mjs",
    "control:sweep": "node test/control_sweep.mjs",
    "real:sweep": "node test/real_app_sweep.mjs",
    "library:visual": "node test/library_visual.mjs",
    "library:flows": "node test/library_flows.mjs",
    "journey:perf": "node test/journey_perf.mjs",
    "mobile:test": "node test/mobile_ux.mjs",
    "mobile:test:all": "node test/mobile_ux.mjs --all && node test/mobile_edge_cases.mjs --all",
    "phone:test": "node test/phone_audit.mjs"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/media": "^9.1.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.1",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.4.1",
    "@playwright/test": "^1.63.0",
    "patch-package": "^8.0.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.48.0",
    "pngjs": "^7.0.0"
  }
}
