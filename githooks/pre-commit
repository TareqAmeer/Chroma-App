#!/bin/sh
# Wireframe-fidelity gate: blocks a commit touching the Library/Editor UI against
# chromasmith-design/project/*.html without a clean, current wireframe-diff run for that file.
# See .claude/plans (wireframe fidelity incident) and the "Wireframe fidelity gate" memory —
# a diff tool for exactly this existed, was never run again after the commit that added it,
# and 71 real mismatches went unnoticed for a week. This makes running it non-optional.
set -e

check() {
  file="$1"; stamp="$2"; cmd="$3"
  if ! git diff --cached --name-only | grep -qx "$file"; then return 0; fi
  if [ ! -f "$stamp" ]; then
    echo "BLOCKED: $file changed but its wireframe diff has never been run in this checkout."
    echo "Run: $cmd   (review the output, then: touch $stamp)"
    exit 1
  fi
  stamp_time=$(stat -f %m "$stamp" 2>/dev/null || stat -c %Y "$stamp" 2>/dev/null)
  file_time=$(stat -f %m "$file" 2>/dev/null || stat -c %Y "$file" 2>/dev/null)
  if [ "$file_time" -gt "$stamp_time" ]; then
    echo "BLOCKED: $file changed after the last wireframe diff review ($stamp is stale)."
    echo "Run: $cmd, review the output, then: touch $stamp"
    exit 1
  fi
}

check "desktop/library-ui.js" ".git/.wireframe_diff_ok" "node test/wireframe_diff.mjs"
check "chromasmith-22.html" ".git/.editor_wireframe_diff_ok" "node test/editor_wireframe_diff.mjs"
exit 0
