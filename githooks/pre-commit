#!/bin/sh
# Wireframe-fidelity gate: blocks a commit touching the Library/Editor UI against
# chromasmith-design/project/*.html unless the structural inventory check passes (or every
# remaining finding is explicitly allowlisted in test/wireframe_accepted.json).
#
# This REPLACES an earlier stamp-file version (`touch .git/.wireframe_diff_ok`) that only proved
# the tool had been RUN, not that it PASSED — a hand-written 13-pair colour/font check reported a
# shrinking number while 71 real Library mismatches (duplicate search icon, wrong section
# placement, a non-collapsing sidebar, ...) shipped untouched. See CLAUDE.md's wireframe fidelity
# gate note. Fixing this is the point: a real gate that fails the commit, not a checklist step.
set -e

needs_check() {
  git diff --cached --name-only | grep -qx "$1"
}

if needs_check "desktop/library-ui.js"; then
  echo "desktop/library-ui.js changed — running wireframe structural inventory..."
  bash build-desktop.sh >/dev/null 2>&1 || { echo "BLOCKED: build-desktop.sh failed."; exit 1; }
  if ! node test/wireframe_inventory.mjs; then
    echo ""
    echo "BLOCKED: desktop/library-ui.js diverges from the wireframe (see findings above)."
    echo "Fix it, or if the divergence is deliberate, add an entry to test/wireframe_accepted.json"
    echo "with a {\"match\": \"<substring of the finding line>\", \"reason\": \"...\"} object."
    exit 1
  fi
fi

if needs_check "chromasmith-22.html"; then
  echo "chromasmith-22.html changed — running all Editor gates (test/editor_gates.mjs)..."
  # Was: only editor_wireframe_diff.mjs, hand-retried 6x here for the documented E7 flake
  # (editor_ux_spec.json, since fixed at its real root cause — see editor_gates.mjs). That left
  # editor:inventory/responsive/coverage/snap-check/html-check — every OTHER Editor gate —
  # unenforced at commit time, reachable only through `npm test` (which itself never rebuilt
  # desktop/dist/ before this session's fix — see editor_gates.mjs's own comment). Calling
  # editor_gates.mjs here instead runs every Editor gate and rebuilds desktop/dist/ first so none
  # of them can pass against stale code.
  #
  # --advisory (added 2026-09-10, explicit user decision after this uncovered 253 pre-existing,
  # unallowlisted editor:inventory findings on an otherwise-clean tree — none introduced by
  # whatever commit happens to touch chromasmith-22.html next): editor:inventory/responsive/
  # coverage print their findings here but don't block the commit; editor:snap-check/html-check/
  # wireframe-diff still do — see editor_gates.mjs's own comment for why that split. `npm test`
  # and CI call editor_gates.mjs WITHOUT this flag, so they stay fully strict; this only lowers
  # local commit friction from a backlog this hook is not the right place to force someone to
  # triage mid-commit.
  if ! node test/editor_gates.mjs --advisory; then
    echo ""
    echo "BLOCKED: one or more Editor gates failed (see output above)."
    exit 1
  fi
fi

exit 0
