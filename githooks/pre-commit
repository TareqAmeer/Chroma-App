#!/bin/sh
# Wireframe-fidelity gate: blocks a commit touching the Library/Editor UI against
# chromasmith-design/project/*.html without a clean, current wireframe_diff run.
# See .claude/plans (wireframe fidelity incident) and the "Wireframe fidelity gate" memory —
# a diff tool for exactly this existed, was never run again after the commit that added it,
# and 71 real mismatches went unnoticed for a week. This makes running it non-optional.
set -e

STAMP=".git/.wireframe_diff_ok"
WATCHED='^(chromasmith-22\.html|desktop/library-ui\.js)$'

changed=$(git diff --cached --name-only | grep -E "$WATCHED" || true)
if [ -z "$changed" ]; then
  exit 0
fi

if [ ! -f "$STAMP" ]; then
  echo "BLOCKED: $changed changed but wireframe_diff has never been run in this checkout."
  echo "Run: node test/wireframe_diff.mjs   (must print RESULT: PASS, or you accept the mismatches)"
  echo "Then: touch $STAMP   to record you reviewed the current output, and re-commit."
  exit 1
fi

stamp_time=$(stat -f %m "$STAMP" 2>/dev/null || stat -c %Y "$STAMP" 2>/dev/null)
for f in $changed; do
  file_time=$(stat -f %m "$f" 2>/dev/null || stat -c %Y "$f" 2>/dev/null)
  if [ "$file_time" -gt "$stamp_time" ]; then
    echo "BLOCKED: $f changed after the last wireframe_diff review ($STAMP is stale)."
    echo "Run: node test/wireframe_diff.mjs, review the output, then: touch $STAMP"
    exit 1
  fi
done

exit 0
