{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/forms/**",
              "components/navigation/**",
              "components/surfaces/**",
              "ui_kits/_shared/**",
              "ui_kits/chromasmith-app/**",
              "ui_kits/chromasmith-web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:SF Pro Display|SF Pro Text))/i]",
        "message": "Font not provided by the design system. Available: SF Pro Display, SF Pro Text."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|onDark|disabled|fullWidth|as|href|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, onDark, disabled, fullWidth, as, href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondaryPill|darkUtility|pearlCapsule|storeHero)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondaryPill' | 'darkUtility' | 'pearlCapsule' | 'storeHero'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|note|legal|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: columns, note, legal."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlobalNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|links|right|key|ref|className|style|children)$/]",
        "message": "<GlobalNav> doesn't accept that prop. Declared props: brand, links, right."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|label|children|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: variant, size, label, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:translucent|dark|plain|plainOnDark|outline)$/]",
        "message": "<IconButton> variant must be one of 'translucent' | 'dark' | 'plain' | 'plainOnDark' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OptionChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|detail|thumb|selected|disabled|onDark|key|ref|className|style|children)$/]",
        "message": "<OptionChip> doesn't accept that prop. Declared props: label, detail, thumb, selected, disabled, onDark."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:surface|eyebrow|title|tagline|actions|media|align|tight|key|ref|className|style|children)$/]",
        "message": "<ProductTile> doesn't accept that prop. Declared props: surface, eyebrow, title, tagline, actions, media, align, tight."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductTile'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:light|parchment|linen|dark|dark2|dark3)$/]",
        "message": "<ProductTile> surface must be one of 'light' | 'parchment' | 'linen' | 'dark' | 'dark2' | 'dark3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductTile'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<ProductTile> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|quote|attribution|action|image|key|ref|className|style|children)$/]",
        "message": "<QuoteCard> doesn't accept that prop. Declared props: kicker, quote, attribution, action, image."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|icon|onDark|key|ref|className|style|children)$/]",
        "message": "<SearchInput> doesn't accept that prop. Declared props: placeholder, icon, onDark."
      },
      {
        "selector": "JSXOpeningElement[name.name='StickyBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|detail|actions|onDark|key|ref|className|style|children)$/]",
        "message": "<StickyBar> doesn't accept that prop. Declared props: label, detail, actions, onDark."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|links|cta|onDark|key|ref|className|style|children)$/]",
        "message": "<SubNav> doesn't accept that prop. Declared props: title, links, cta, onDark."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:onDark|underline|size|children|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: onDark, underline, size, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:body|caption|dense)$/]",
        "message": "<TextLink> size must be one of 'body' | 'caption' | 'dense'."
      },
      {
        "selector": "JSXOpeningElement[name.name='UtilityCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|title|meta|price|action|badge|key|ref|className|style|children)$/]",
        "message": "<UtilityCard> doesn't accept that prop. Declared props: image, title, meta, price, action, badge."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
