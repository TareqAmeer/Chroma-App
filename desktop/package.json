{
  "name": "chromasmith-desktop",
  "version": "1.0.0",
  "description": "Chromasmith — native macOS shell (Tauri) wrapping the single-file web app",
  "private": true,
  "scripts": {
    "build:dist": "node ../tools/scripts/build-desktop.mjs",
    "dev": "npm run build:dist && node ../scripts/tauri-shared-cache.mjs dev",
    "build": "npm run build:dist && node ../scripts/tauri-shared-cache.mjs build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "^2.1.0"
  }
}
