{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Chromasmith desktop — personal-use app, broad local-file access by design (open any photo, export anywhere).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:menu:default",
    "dialog:default",
    "log:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$HOME/**" }]
    }
  ]
}
