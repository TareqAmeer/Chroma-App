{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chromasmith",
  "version": "1.0.0",
  "identifier": "com.tareq.chromasmith",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Chromasmith",
        "url": "cs://localhost/index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true,
        "backgroundColor": "#141414"
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["adobe+5e575447f1fc4a4228c93a157e8422d9f310dd31"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "resources": {
      "vendor/onnxruntime/libonnxruntime.dylib": "vendor/onnxruntime/libonnxruntime.dylib",
      "vendor/sam2/encoder.onnx": "vendor/sam2/encoder.onnx",
      "vendor/sam2/decoder.onnx": "vendor/sam2/decoder.onnx",
      "vendor/faceparse/model_quantized.onnx": "vendor/faceparse/model_quantized.onnx",
      "vendor/rawdenoise/model_linear.onnx": "vendor/rawdenoise/model_linear.onnx",
      "vendor/rawdenoise/model_bayer.onnx": "vendor/rawdenoise/model_bayer.onnx",
      "../dist": "dist"
    },
    "fileAssociations": [
      {
        "ext": ["tif", "tiff"],
        "name": "TIFF Image",
        "description": "TIFF Image",
        "role": "Editor"
      },
      {
        "ext": ["jpg", "jpeg"],
        "name": "JPEG Image",
        "description": "JPEG Image",
        "role": "Editor"
      },
      {
        "ext": ["png"],
        "name": "PNG Image",
        "description": "PNG Image",
        "role": "Editor"
      },
      {
        "ext": ["rw2", "raw"],
        "name": "RAW Photo",
        "description": "Panasonic RAW Photo",
        "role": "Editor"
      }
    ]
  }
}
