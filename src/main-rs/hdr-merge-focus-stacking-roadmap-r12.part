// ROADMAP R13 part 1 (collage) — the compositing itself runs entirely client-side in
// chromasmith-22.html's/library-ui.js's own canvas (no alignment or heavy pixel math needed for
// a fixed-template layout), so the only Rust piece it needs is the same collision-safe output
// path convention `merge_output_path` already gives HDR/focus/astro merges; `write_file_bytes`
// (already registered below) then writes the composited PNG the JS side builds.
#[tauri::command(async)]
fn collage_output_path(first_source: String) -> String {
    merge_output_path(&first_source, "-collage")
}

fn film_negative_input<'a>(source: &'a [u16], json: &serde_json::Value) -> Result<std::borrow::Cow<'a, [u16]>, String> {
    let recipe = &json["filmNegative"];
    if recipe.is_null() { return Ok(std::borrow::Cow::Borrowed(source)); }
    if recipe["domain"].as_str() != Some("camera-linear16-v1") { return Err("film negative: unsupported calibration domain; pick native film base again".into()); }
    let read3 = |key: &str| -> Result<[f64; 3], String> {
        let a = recipe[key].as_array().ok_or_else(|| format!("film negative: missing {key}"))?;
        if a.len() != 3 { return Err(format!("film negative: invalid {key}")); }
        Ok([a[0].as_f64().ok_or("invalid channel")?, a[1].as_f64().ok_or("invalid channel")?, a[2].as_f64().ok_or("invalid channel")?])
    };
    Ok(std::borrow::Cow::Owned(film_negative::convert_rgb16(source, read3("ref")?, read3("exp")?, recipe["out"].as_f64().ok_or("film negative: missing output reference")?, recipe["bw"].as_bool().unwrap_or(false))?))
}

fn film_source_key(payload: &[u8], json: &serde_json::Value) -> u64 {
    // Persisted calibration identities must remain stable across Rust/app upgrades.
    let mut h = blake3::Hasher::new();
    h.update(payload);
    for key in ["lutKey", "autoLens", "demosaicAlgo", "lensOverride", "lensOverrideFocal"] {
        let value = json[key].to_string();
        h.update(&(value.len() as u64).to_le_bytes());h.update(value.as_bytes());
    }
    u64::from_le_bytes(h.finalize().as_bytes()[..8].try_into().unwrap()) & ((1u64 << 52) - 1)
}

#[cfg(test)]
mod film_negative_native_tests;

fn check_film_source(payload: &[u8], json: &serde_json::Value) -> Result<(), String> {
    if json["filmNegative"].is_object() && json["filmNegative"]["sourceKey"].as_u64() != Some(film_source_key(payload, json)) {
        return Err("film negative: source/profile/geometry changed; pick native base again".into());
    }
    Ok(())
}

fn film_negative_bw(body: &mut [u8], mode: &str, json: &serde_json::Value) {
    if matches!(mode, "lut" | "srgb") && json["filmNegative"]["bw"].as_bool() == Some(true) {
        for pixel in body.chunks_exact_mut(4) {
            let gray = (0.2126 * pixel[0] as f64 + 0.7152 * pixel[1] as f64 + 0.0722 * pixel[2] as f64).round() as u8;
            pixel[0] = gray; pixel[1] = gray; pixel[2] = gray;
        }
    }
}

#[tauri::command(async)]
fn decode_raw_v2(request: tauri::ipc::Request) -> Result<tauri::ipc::Response, String> {
    let (json, payload) = parse_framed(request.body())?;
    decode_raw_v2_payload(&json, payload)
}

fn decode_raw_v2_payload(json: &serde_json::Value, payload: &[u8]) -> Result<tauri::ipc::Response, String> {
    // A half-first open already started this exact full decode (see SPEC_FULL): wait for it.
    if json["half"].as_bool() != Some(true) && payload.is_empty() {
        if let Some(res) = take_speculative_full(json) { return res.map(tauri::ipc::Response::new); }
    }
    decode_raw_v2_vec(json, payload, None).map(tauri::ipc::Response::new)
}

/// The full decode a half-first open starts as soon as the parsed sensor data is ready, so the
/// full demosaic overlaps the half picture's own tail + IPC + JS install instead of starting only
/// when JS asks for it. JS's follow-up full request carries the same parameters (minus `half`);
/// when it matches it simply takes this result. Single slot, bounded: a newer half open replaces
/// an unclaimed older result.
struct SpecFull {
    json: serde_json::Value,
    slot: std::sync::Arc<(Mutex<Option<Result<Vec<u8>, String>>>, std::sync::Condvar)>,
}
static SPEC_FULL: Mutex<Option<SpecFull>> = Mutex::new(None);
static SPEC_POOL: std::sync::OnceLock<Option<rayon::ThreadPool>> = std::sync::OnceLock::new();

fn spec_key_json(json: &serde_json::Value) -> serde_json::Value {
    let mut j = json.clone();
    if let Some(o) = j.as_object_mut() { o.remove("half"); }
    j
}

fn take_speculative_full(json: &serde_json::Value) -> Option<Result<Vec<u8>, String>> {
    let want = spec_key_json(json);
    let slot = {
        let mut g = SPEC_FULL.lock().ok()?;
        match g.take() {
            Some(s) if s.json == want => s.slot,
            other => { *g = other; return None; }
        }
    };
    let (lock, cv) = &*slot;
    let mut res = lock.lock().ok()?;
    while res.is_none() { res = cv.wait(res).ok()?; }
    diag::log("info", "RAW_DIAG spec_full taken".to_string());
    res.take()
}

fn start_speculative_full(json: &serde_json::Value, bytes: std::sync::Arc<Vec<u8>>) {
    if std::env::var("CS_SPEC_FULL").as_deref() == Ok("0") { return; }
    let pool = SPEC_POOL.get_or_init(|| rayon::ThreadPoolBuilder::new().num_threads(1)
        .thread_name(|_| "cs-raw-full".into()).build().ok());
    let Some(pool) = pool else { return };
    let key = spec_key_json(json);
    let slot = std::sync::Arc::new((Mutex::new(None), std::sync::Condvar::new()));
    if let Ok(mut g) = SPEC_FULL.lock() { *g = Some(SpecFull { json: key.clone(), slot: slot.clone() }); }
    pool.spawn(move || {
        let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| decode_raw_v2_vec(&key, &[], Some(bytes))))
            .unwrap_or_else(|_| Err("full decode panicked".to_string()));
        let (lock, cv) = &*slot;
        if let Ok(mut res) = lock.lock() { *res = Some(r); }
        cv.notify_all();
    });
}

fn decode_raw_v2_vec(json: &serde_json::Value, payload: &[u8], pre_shared: Option<std::sync::Arc<Vec<u8>>>) -> Result<Vec<u8>, String> {
    // sourcePath + empty payload: read the RAW natively (Library opens) instead of receiving the
    // whole file over IPC. Same bytes either way, so the decode (and its memo key) is identical.
    let path_bytes: Option<std::sync::Arc<Vec<u8>>>;
    let payload: &[u8] = match (payload.is_empty(), json["sourcePath"].as_str()) {
        _ if pre_shared.is_some() => {
            path_bytes = pre_shared;
            path_bytes.as_ref().map(|b| b.as_slice()).unwrap_or_default()
        }
        (true, Some(p)) if !p.is_empty() => {
            // Owned once and SHARED with rawler (RawSource::new_from_shared_vec) — the slice form
            // copied the whole ~30MB file again inside the decoder.
            path_bytes = Some(std::sync::Arc::new(std::fs::read(p).map_err(|e| format!("read {p}: {e}"))?));
            path_bytes.as_ref().map(|b| b.as_slice()).unwrap_or_default()
        }
        _ => { path_bytes = None; payload }
    };
    let mode = json["mode"].as_str().unwrap_or("linear16");
    check_film_source(payload, &json)?;
    let film_source = json["filmSource"].as_bool().unwrap_or(false) || mode == "sampleFilmBase" || json["filmNegative"].is_object();
    let auto_lens = json["autoLens"].as_bool().unwrap_or(false);
    // "off"|"fast" ONLY — decode_raw_v2 is also the Library's thumbnail-decode path, so it must
    // be STRUCTURALLY unable to trigger the ~25-90s neural High tier no matter what a caller
    // sends; High only ever runs via the separate denoise_raw_high command below (see the
    // denoiser design doc §A4). `nativeNr` (bool) is kept as a fallback for any caller still on
    // the pre-tier JS build (desktop-native.js ships both fields for one release — see
    // chromasmith-22.html's applyUISnapshot migration comment).
    let nr = match json["rawNr"].as_str() {
        Some("off") => raw_decode::NrTier::Off,
        Some("fast") => raw_decode::NrTier::Fast,
        Some("chroma") => raw_decode::NrTier::Chroma,
        Some(other) => {
            eprintln!("decode_raw_v2: rawNr={other:?} not accepted here (High runs via denoise_raw_high) — using Fast");
            raw_decode::NrTier::Fast
        }
        None => {
            if json["nativeNr"].as_bool().unwrap_or(true) {
                raw_decode::NrTier::Fast
            } else {
                raw_decode::NrTier::Off
            }
        }
    };
    // Per-photo "RAW Processing" mode ("" = Standard/PPG, "ahd" = Sparkle-optimized) — see
    // raw_decode.rs's decode_rw2_bytes doc comment for why this is opt-in, not a global default.
    // Validate at the UI boundary: raw_decode.rs's decode_and_demosaic only accepts "" (PPG),
    // "ahd", "vng", "mhc", "markesteijn1", or "markesteijn3" — any other string used to reach a `panic!` deep inside the demosaic
    // branch and take down the whole process. An unrecognized value here (stale localStorage,
    // future JS typo, etc.) now silently falls back to the standard "" (PPG) algorithm instead.
    let demosaic_algo_raw = json["demosaicAlgo"].as_str().unwrap_or("");
    let demosaic_algo = match demosaic_algo_raw {
        "" | "ahd" | "vng" | "mhc" | "markesteijn1" | "markesteijn3" => demosaic_algo_raw,
        other => {
            eprintln!("decode_raw_v2: unknown demosaicAlgo={other:?} — defaulting to standard (PPG)");
            ""
        }
    };
    // Two-phase decode: `fast=true` skips the false-color-suppression / hue-defringe / native-NR
    // passes (the serial, full-frame CPU work that made RAW opens take up to ~15s) so the shell
    // can display a photo almost immediately, then request a `fast=false` decode of the SAME
    // bytes in the background to silently upgrade to full quality once it lands (see
    // desktop/desktop-native.js's NativeLibRawShim.open()/refine()). Defaults to false so any
    // caller that doesn't set it gets today's unchanged, full-quality-only behavior.
    let fast = json["fast"].as_bool().unwrap_or(false);
    let _raw_diag = diag::raw_op(format!(
        "decode_raw_v2 mode={} fast={} bytes={}",
        mode, fast, payload.len()
    ));
    // Manual lens override (see list_lens_profiles below): a "Maker Model" string the user
    // picked from the bundled DB's own lens list, paired with a focal length in mm — for
    // manual/adapted lenses (TTArtisan and similar) that write no lens EXIF at all, so no
    // amount of EXIF fallback can recover a tag the camera never wrote.
    let lens_override = match (json["lensOverride"].as_str(), json["lensOverrideFocal"].as_f64()) {
        (Some(l), Some(f)) if !l.is_empty() && f > 0.0 => Some((l, f as f32)),
        _ => None,
    };
    // The RAW bytes are hashed ONCE per request; raw_decode's own demosaic/prepared caches key on
    // this same value (RawInput.hash) instead of re-hashing the 30MB file.
    let raw_input = raw_decode::RawInput { bytes: payload, shared: path_bytes.as_ref(), hash: raw_decode::raw_bytes_hash(payload) };
    // Half-resolution first picture (cold Library open, see raw_decode::decode_rw2_half): only for
    // a final RGBA body (lut/srgb), never film work or the HDR companion. The full-quality decode
    // JS requests right after it is a normal fast=false call and takes the prepared Bayer data.
    let want_half = json["half"].as_bool().unwrap_or(false) && matches!(mode, "lut" | "srgb") && !film_source
        && !json["wantExt"].as_bool().unwrap_or(false) && json["filmNegative"].is_null();
    let mut hasher = std::collections::hash_map::DefaultHasher::new();
    raw_input.hash.hash(&mut hasher);
    format!("{nr:?}").hash(&mut hasher);
    demosaic_algo.hash(&mut hasher);
    fast.hash(&mut hasher);
    film_source.hash(&mut hasher);
    auto_lens.hash(&mut hasher);
    lens_override.map(|(l, f)| (l, f.to_bits())).hash(&mut hasher);
    let decode_key = hasher.finish();
    let mut _st = std::time::Instant::now(); // per-stage RAW_DIAG op=v2 lines (CS_DIAG_RAW_STAGES=1)
    let interactive = json["lutKey"].as_str().is_some();
    // Never cached in RAW_DECODE_CACHE (single slot): it would evict the full frame that matters.
    // A full decode of exactly this request already in memory beats any half picture.
    let full_in_memory = want_half && RAW_DECODE_CACHE.lock().ok().is_some_and(|g| g.as_ref().is_some_and(|e| e.key == decode_key));
    let half: Option<raw_decode::DecodedRaw> = if want_half && !full_in_memory {
        // Start the full decode as soon as the sensor data is parsed (it takes the parked Bayer
        // data), not when JS asks: only when this request has everything the full call needs.
        let spec_bytes = if interactive && json["cachePath"].is_string() { path_bytes.clone() } else { None };
        let on_prepared = || { if let Some(b) = spec_bytes.clone() { start_speculative_full(json, b); } };
        let run = || raw_decode::decode_rw2_half_then(&raw_input, nr, film_source, &on_prepared);
        if interactive { on_interactive_pool(run)? } else { run()? }
    } else { None };
    let is_half = half.is_some();
    let decoded: std::sync::Arc<raw_decode::DecodedRaw> = if let Some(h) = half { std::sync::Arc::new(h) } else {
        let cached = RAW_DECODE_CACHE
            .lock()
            .ok()
            .and_then(|g| g.as_ref().filter(|e| e.key == decode_key).map(|e| e.decoded.clone()));
        match cached {
            Some(d) => d,
            None => {
                // The previous photo's single-slot decode (~144MB) is dead weight from here on;
                // drop it BEFORE this decode allocates its own frames, not after.
                if let Ok(mut guard) = RAW_DECODE_CACHE.lock() { *guard = None; }
                let run = || raw_decode::decode_rw2_input(&raw_input, auto_lens, nr, demosaic_algo, fast, lens_override, 1.0, None, None, film_source);
                let d = std::sync::Arc::new(if interactive { on_interactive_pool(run)? } else { run()? });
                if let Ok(mut guard) = RAW_DECODE_CACHE.lock() {
                    *guard = Some(RawDecodeCacheEntry { key: decode_key, decoded: d.clone() });
                }
                d
            }
        }
    };
    if mode == "sampleFilmBase" {
        let nx = json["nx"].as_f64().ok_or("film base: missing x")?;
        let ny = json["ny"].as_f64().ok_or("film base: missing y")?;
        let source = match json["lutKey"].as_str() { Some(key) => lut_input_rgb16(key, payload, &decoded), None => std::borrow::Cow::Borrowed(decoded.rgb16.as_slice()) };
        let (rgb, n) = film_negative::sample_rgb16(&source, decoded.width as usize, decoded.height as usize, nx, ny)?;
        return Ok(serde_json::to_vec(&serde_json::json!({"rgb":rgb,"n":n,"nx":nx,"ny":ny,"domain":"camera-linear16-v1","sourceKey":film_source_key(payload,&json)})).map_err(|e|e.to_string())?);
    }
    // usedLut in the response header tells JS whether its requested mode was actually honored,
    // since the body FORMAT differs (RGBA8 for lut/srgb vs raw u16 for linear16) and it needs to
    // parse the right one. See effective_dcp_mode's doc comment for the "why a backstop" reasoning.
    let lut_key = json["lutKey"].as_str();
    diag::stage("v2", "-", "decode_or_cached", &mut _st);
    let (effective_mode, used_lut) = effective_dcp_mode(mode, &decoded.make, lut_key);
    // docs/ROADMAP.md R1 (scene-referred), desktop path: JS asks for the extended-range companion
    // buffer only when it's actually going to use it (a real DCP LUT apply, not srgb/linear16 —
    // see desktop-native.js's open()). Kept fully opt-in so every existing caller/response shape
    // is untouched when absent — `ext` is None unless want_ext AND the lut branch is taken.
    let want_ext = json["wantExt"].as_bool().unwrap_or(false) && json["filmNegative"]["bw"].as_bool() != Some(true);
    let mut ext: Option<Vec<f32>> = None;
    // Response: [u32 w][u32 h][u32 iso][u32 usedLut][u32 lensApplied][u32 flags][body][ext]
    // [optional working-copy trailer]. flags bit0 = ext follows, bit1 = half-resolution first
    // picture. The plain DCP case writes the LUT result STRAIGHT into the response buffer (it used
    // to land in its own Vec, get copied into `out`, and get cloned a third time for the persist).
    const HDR: usize = 24;
    let px_count = decoded.width as usize * decoded.height as usize;
    let mut out: Vec<u8>;
    match effective_mode {
        "lut" => {
            let key = lut_key.ok_or("missing lutKey")?;
            let lut = {
                let guard = DCP_LUTS.lock().map_err(|_| "DCP LUT cache lock poisoned".to_string())?;
                guard
                    .as_ref()
                    .and_then(|m| m.get(key).cloned())
                    .ok_or_else(|| format!("LUT '{key}' not registered"))?
            };
            let n = (lut.len() / 3) as f64;
            let n = n.cbrt().round() as usize;
            let src = on_interactive_pool(|| lut_input_rgb16(key, payload, &decoded));
            let plain = matches!(src, std::borrow::Cow::Borrowed(_)) && json["filmNegative"].is_null();
            let src = film_negative_input(&src, &json)?;
            if want_ext {
                let (rgba, e) = on_interactive_pool(|| raw_decode::apply_lut_rgba_ext(&src, &lut, n))?;
                ext = Some(e);
                out = Vec::with_capacity(HDR + rgba.len());
                out.extend_from_slice(&[0u8; HDR]);
                out.extend_from_slice(&rgba);
            } else {
                out = vec![0u8; HDR + px_count * 4];
                on_interactive_pool(|| raw_decode::apply_lut_rgba_into(&src, &lut, n, &mut out[HDR..]))?;
                let _ = plain;
            }
        }
        "srgb" => {
            let body = raw_decode::srgb_rgba(&film_negative_input(&decoded.rgb16, &json)?, decoded.xyz_to_cam);
            out = Vec::with_capacity(HDR + body.len());
            out.extend_from_slice(&[0u8; HDR]);
            out.extend_from_slice(&body);
        }
        _ => {
            let src = film_negative_input(&decoded.rgb16, &json)?;
            out = Vec::with_capacity(HDR + src.len() * 2);
            out.extend_from_slice(&[0u8; HDR]);
            for v in src.iter() { out.extend_from_slice(&v.to_le_bytes()); }
        }
    };
    film_negative_bw(&mut out[HDR..], effective_mode, &json);
    diag::stage("v2", "-", "lut_apply", &mut _st);
    // HDR preview asked for the unquantized companion, but JS only uses it when some value is
    // measurably above white (chromasmith-22.html: any > 1.05). When none is, the RGBA8 body is
    // the whole story: drop the companion (JS then sees "no headroom", same as before) so the
    // frame is cacheable like any SDR decode, and leave a marker so later opens may take the
    // cache instead of re-decoding every time (HDR preview used to bypass every cache).
    let mut hdr_clear = false;
    if want_ext {
        if let Some(e) = ext.as_ref() {
            if !e.iter().any(|v| *v > 1.05) { hdr_clear = true; }
        }
        if hdr_clear { ext = None; }
    }
    // Working copy for fit-view editing (chromasmith-22.html's fxDisplayTierCanvas: ~2560px long
    // edge for frames over 3000px), built here with the same SIMD Lanczos3 the display proxy uses
    // instead of a ~340ms main-thread canvas downscale. Appended as a trailer
    // [RGBA8][u32 w][u32 h][4 bytes WRK1] so readers that don't know it are unaffected.
    // A half-resolution first picture (~3000px) gets one too: the editor installs the 2560px copy, not the 6MP frame.
    let work_min_edge: u32 = if is_half { 2560 } else { 3000 };
    let want_work = json["wantWork"].as_bool().unwrap_or(false) && matches!(effective_mode, "lut" | "srgb")
        && decoded.width.max(decoded.height) > work_min_edge;
    // Persistent decode cache for an interactive open (desktop-native.js sends cachePath +
    // recipeKey only on the call whose pixels are FINAL, and only for a real on-disk source).
    // Only the RGBA8 display-referred body is cacheable — same shape cache_raw_decode writes; a
    // linear16 or HDR-companion decode keeps today's uncached behaviour. The size check refuses
    // a request whose bytes aren't that file's (e.g. a stale path from another open path).
    // A half-resolution first picture is NEVER persisted: the cache only ever holds full frames.
    // The RGBA8 body is the frame whether or not the unquantized companion rode along; the
    // companion (real headroom only) is persisted sparsely beside it (library.rs hdrext).
    // Not also inserted into RAW_EDITOR_CACHE: the WebView already holds this frame for promotion
    // (imgCache fullImg), and a second 96MB-per-photo copy was measurable extra swap on 8GB.
    let persist_target: Option<(&str, &str)> = match (json["cachePath"].as_str(), json["recipeKey"].as_str(), is_half) {
        (Some(cp), Some(rk), false) if matches!(effective_mode, "lut" | "srgb") && !cp.is_empty() && !rk.is_empty()
            && std::fs::metadata(cp).is_ok_and(|m| m.len() == payload.len() as u64) => Some((cp, rk)),
        _ => None,
    };
    // The full-frame cache is written straight from the response body (strip container, bands
    // pwritten in parallel) while the 2560px working copy is resized from the same body: both only
    // READ it, so they overlap, and nothing re-runs the LUT or clones the 96MB frame afterwards.
    let file_name = persist_target.map(|(cp, _)| Path::new(cp).file_name().and_then(|v| v.to_str()).unwrap_or("?").to_string()).unwrap_or_default();
    let (work_res, cache_res) = {
        let body = &out[HDR..HDR + px_count * 4];
        let (w, h) = (decoded.width, decoded.height);
        on_interactive_pool(|| rayon::join(
            || if want_work { Some(library::resize_rgba_lanczos(body, w, h, 2560)) } else { None },
            || persist_target.map(|(cp, rk)| library::write_decode_cache_rgba(cp, rk, w, h, body)),
        ))
    };
    if persist_target.is_some() { diag::stage("v2", "-", "persist_cache_write", &mut _st); }
    let mut proxy: Option<image::RgbaImage> = None;
    let work: Option<image::RgbaImage> = match work_res {
        Some(Ok(img)) => { if persist_target.is_some() { proxy = Some(img.clone()); } Some(img) }
        Some(Err(e)) => { eprintln!("decode_raw_v2: working copy skipped: {e}"); None }
        None => None,
    };
    if let Some((cp, rk)) = persist_target {
        match cache_res {
            Some(Ok(())) => {
                // The display proxy is the same 2560px Lanczos frame as the working copy: encode it
                // from that in the background; a frame with no working copy (<=3000px) is small, so
                // its proxy is built inline.
                if proxy.is_none() {
                    let mut st = std::time::Instant::now();
                    let body = &out[HDR..HDR + px_count * 4];
                    if let Err(e) = library::write_display_cache_from_rgba(cp, rk, decoded.width, decoded.height, body, 2560, &file_name, &mut st) {
                        eprintln!("persist display proxy for {file_name}: {e}");
                    }
                }
                if hdr_clear {
                    library::write_hdr_clear_marker(cp, rk);
                } else if let Some(blob) = ext.as_ref().and_then(|e| library::build_hdr_ext_blob(cp, rk, decoded.width, decoded.height, e)) {
                    library::write_hdr_ext_blob(cp, rk, &blob);
                }
                if let Some(img) = proxy.take() { persist_proxy_in_background(cp.to_string(), rk.to_string(), img); }
            }
            Some(Err(e)) => eprintln!("persist decode cache for {file_name}: {e}"),
            None => {}
        }
    }
    diag::stage("v2", "-", "persist_prep", &mut _st);
    let lens_applied: u32 = if decoded.lens_applied { 1 } else { 0 };
    let flags: u32 = (if ext.is_some() { 1 } else { 0 }) | (if is_half { 2 } else { 0 });
    out[0..4].copy_from_slice(&decoded.width.to_le_bytes());
    out[4..8].copy_from_slice(&decoded.height.to_le_bytes());
    out[8..12].copy_from_slice(&decoded.iso.to_le_bytes());
    out[12..16].copy_from_slice(&used_lut.to_le_bytes());
    out[16..20].copy_from_slice(&lens_applied.to_le_bytes());
    out[20..24].copy_from_slice(&flags.to_le_bytes());
    if let Some(e) = ext {
        out.reserve(e.len() * 4);
        for v in e { out.extend_from_slice(&v.to_le_bytes()); }
    }
    if let Some(work) = work {
        let (ww, wh) = (work.width(), work.height());
        let raw = work.into_raw();
        out.reserve(raw.len() + 12);
        out.extend_from_slice(&raw);
        out.extend_from_slice(&ww.to_le_bytes());
        out.extend_from_slice(&wh.to_le_bytes());
        out.extend_from_slice(WORK_TRAILER_MAGIC);
        diag::stage("v2", "-", "work_copy", &mut _st);
    }
    diag::stage("v2", "-", "response_build", &mut _st);
    Ok(out)
}

/// Warms the persistent editor cache without opening photos in the WebView. One native full
/// decode is used per photo; future opens use the lossless in-process pixels instead of paying
/// the RAW demosaic cost again. The persistent PNG remains the restart fallback.
#[tauri::command(async)]
fn cache_raw_decode(
    path: String,
    recipe_key: String,
    mode: String,
    lut_key: String,
    raw_nr: String,
    auto_lens: bool,
    demosaic_algo: String,
    lens_override: String,
    lens_override_focal: f64,
    display_only: Option<bool>,
    background: Option<bool>,
) -> Result<String, String> {
    let display_only = display_only.unwrap_or(false);
    // Idle background preview building (Library auto-prep) is NOT user-waiting: on the
    // user-initiated interactive pool it took every core at the same QoS as the editor open the
    // user clicks next, so a click landing mid-build had its own decode slowed. Keep it on the
    // global utility pool; explicit Review/Quick Look prep still gets the interactive pool.
    let foreground = display_only && !background.unwrap_or(false);
    let file_name = Path::new(&path)
        .file_name()
        .and_then(|v| v.to_str())
        .unwrap_or("?")
        .to_string();
    let _raw_diag = diag::raw_op(format!("cache_raw_decode file={file_name}"));
    let mut stage_t = std::time::Instant::now();
    let ext = Path::new(&path)
        .extension()
        .and_then(|e| e.to_str())
        .unwrap_or("")
        .to_ascii_lowercase();
    if !formats::is_raw_ext(&ext) {
        return Err("selected file is not a RAW photo".into());
    }
    if library::decode_cache_exists(&path, &recipe_key)? {
        diag::stage("cache", &file_name, "already_cached_check", &mut stage_t);
        let display_path =
            library::get_display_decode_cache(path.clone(), recipe_key.clone(), 2560)?;
        diag::stage(
            "cache",
            &file_name,
            "display_proxy_from_existing",
            &mut stage_t,
        );
        if display_only {
            return Ok(display_path);
        }
        // CHR-120: this shortcut used to return without ever touching RAW_EDITOR_CACHE — so a
        // "Cache RAWs" batch action on a photo already cached from an earlier app launch (the
        // common case: the on-disk PNG persists across relaunches, RAW_EDITOR_CACHE does not)
        // warmed nothing, and the very next interactive open fell through to the much slower
        // asset-protocol PNG-decode path instead of the fast in-process path — confirmed live:
        // this exact case measured ~9s to full quality vs ~6s when the in-process cache really
        // was warm. Best-effort: read the existing PNG back in and populate the in-process
        // cache from it, same shape as the fresh-decode path below; a failure here just means
        // the interactive open falls back to the PNG path as it always did, no regression.
        if let Ok(meta) = std::fs::metadata(&path) {
            let mtime = meta
                .modified()
                .ok()
                .and_then(|t| t.duration_since(std::time::UNIX_EPOCH).ok())
                .map(|d| d.as_secs())
                .unwrap_or(0);
            // CHR-120: skip the PNG read+decode entirely when RAW_EDITOR_CACHE already holds
            // this exact (path, recipe, mtime, size) — this branch used to pay it every single
            // call regardless, so calling "Cache RAWs" twice on the same already-cached photo in
            // one session (or an interactive reopen right after a batch cache, which takes this
            // same shortcut) re-read and re-decoded a PNG it had JUST put in memory moments
            // earlier. Confirmed live via tools/diagnostics/raw_bench.py's "cached" scenario.
            let already_in_process = RAW_EDITOR_CACHE
                .lock()
                .ok()
                .map(|g| {
                    g.iter().any(|e| {
                        e.path == path
                            && e.recipe_key == recipe_key
                            && e.mtime == mtime
                            && e.size == meta.len()
                    })
                })
                .unwrap_or(false);
            if already_in_process {
                diag::stage(
                    "cache",
                    &file_name,
                    "already_in_process_cache",
                    &mut stage_t,
                );
            } else if let Ok(rgba_img) = library::read_decode_cache_rgba(&path, &recipe_key) {
                let (w, h) = (rgba_img.width(), rgba_img.height());
                raw_editor_cache_insert(
                    &path,
                    &recipe_key,
                    mtime,
                    meta.len(),
                    w,
                    h,
                    std::sync::Arc::new(rgba_img.into_raw()),
                );
                diag::stage(
                    "cache",
                    &file_name,
                    "reread_cache_into_process_cache",
                    &mut stage_t,
                );
            }
        }
        return Ok("cached".into());
    }
    if display_only {
        if let Ok(display_path) =
            library::get_display_decode_cache_path(path.clone(), recipe_key.clone(), 2560)
        {
            return Ok(display_path);
        }
    }
    let bytes = std::fs::read(&path).map_err(|e| format!("read {path}: {e}"))?;
    diag::stage("cache", &file_name, "read_file", &mut stage_t);
    // decode_rw2_bytes emits its own finer-grained RAW_DIAG stage= lines (demosaic_or_cache,
    // high_nr, false_color, hue_defringe, orientation, lens, native_nr — raw_decode.rs) under
    // op=decode; this coarser "decode_total" line below lets a consumer that only wants the
    // top-level breakdown skip summing those without losing them for one that wants the detail.
    let develop = || -> Result<(raw_decode::DecodedRaw, Vec<u8>, bool, Option<Vec<u8>>), String> {
        let result = develop_raw_frame(
            &path,
            &recipe_key,
            &bytes,
            &mode,
            &lut_key,
            &raw_nr,
            auto_lens,
            &demosaic_algo,
            &lens_override,
            lens_override_focal,
            true,
        )?;
        diag::stage("cache", &file_name, "decode_total", &mut stage_t);
        diag::stage("cache", &file_name, "colour_convert", &mut stage_t);
        Ok(result)
    };
    // Batch/full-cache work keeps its existing global-pool behavior. Only the explicitly
    // user-waiting display-only review decode and its full-frame color conversion are promoted.
    let (decoded, rgba, hdr_clear, hdr_blob) = run_raw_cache_development(foreground, develop)?;
    let img = image::RgbaImage::from_raw(decoded.width, decoded.height, rgba)
        .ok_or("decoded RGBA dimensions do not match")?;
    let rgba = img.into_raw();
    if display_only {
        // RAW review needs only a bounded display asset. Keep the developed pixels transient:
        // this branch must not write the full decode cache or warm RAW_EDITOR_CACHE.
        return library::write_display_cache_from_rgba(
            &path,
            &recipe_key,
            decoded.width,
            decoded.height,
            &rgba,
            2560,
            &file_name,
            &mut stage_t,
        );
    }
    let meta = std::fs::metadata(&path).map_err(|e| format!("stat {path}: {e}"))?;
    let mtime = meta
        .modified()
        .ok()
        .and_then(|t| t.duration_since(std::time::UNIX_EPOCH).ok())
        .map(|d| d.as_secs())
        .unwrap_or(0);
    let rgba = std::sync::Arc::new(rgba);
    raw_editor_cache_insert(
        &path,
        &recipe_key,
        mtime,
        meta.len(),
        decoded.width,
        decoded.height,
        rgba.clone(),
    );
    diag::stage("cache", &file_name, "in_process_cache_insert", &mut stage_t);
    // Persistent fallback for the next launch (PNG) + the display-sized proxy — the in-process
    // cache above is the fast path. Same helper the interactive open uses (decode_raw_v2).
    persist_decoded_rgba(
        &path,
        &recipe_key,
        decoded.width,
        decoded.height,
        &rgba,
        &file_name,
        &mut stage_t,
    )?;
    if hdr_clear {
        library::write_hdr_clear_marker(&path, &recipe_key);
    } else if let Some(b) = hdr_blob.as_ref() {
        library::write_hdr_ext_blob(&path, &recipe_key, b);
    }
    Ok("written".into())
}

#[derive(serde::Serialize)]
#[serde(rename_all = "camelCase")]
struct RawFaceCropHeader {
    face_id: i64,
    width: u32,
    height: u32,
    offset: usize,
    length: usize,
}
#[derive(serde::Serialize)]
#[serde(rename_all = "camelCase")]
struct RawFaceDetailHeader {
    source_width: u32,
    source_height: u32,
    lens_correction_applied: bool,
    crops: Vec<RawFaceCropHeader>,
}
