        let after: Option<i64> = conn.query_row("SELECT person_id FROM photo_faces WHERE id = ?1", params![fid], |r| r.get(0)).unwrap();
        assert_eq!(after, Some(pet), "a people re-cluster must not unfile a pet sighting");
