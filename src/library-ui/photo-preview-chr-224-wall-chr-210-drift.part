    const down = (e) => { drag = { x: e.clientX, y: e.clientY, t: performance.now() }; moved = false; vx = vy = 0; };
    const move = (e) => { if (!drag) return; const dx = e.clientX - drag.x, dy = e.clientY - drag.y; if (Math.abs(dx) + Math.abs(dy) > 3) moved = true;
