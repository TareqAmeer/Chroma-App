    document.body.appendChild(root);
    pv.onKey = (e) => { if (e.key === 'Escape') { e.stopPropagation(); closePhotoPreview(); return; } if (pv && pv.keyHook) pv.keyHook(e); };
    window.addEventListener('keydown', pv.onKey, true);
