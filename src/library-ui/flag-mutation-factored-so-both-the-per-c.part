  // ── flag mutation, factored so both the per-card flag clicks AND the
  // multi-select context menu can apply the same write+cache+redraw logic. ─────────────────
  // A failed sidecar write (read-only volume, permissions, disk full) used to be swallowed by
  // `.catch(() => {})` while the UI updated optimistically — the flag LOOKED set but silently
  // vanished on relaunch, losing culling work with no hint why. Surface it and roll back.
  function sidecarWriteFailed(path, prev, e) {
    state.sidecars.set(path, prev);
    console.error('set_sidecar failed', path, e);
    if (typeof toast === 'function') toast('Could not save flag/edit state — is this folder writable?', false);
    else if (typeof log === 'function') log(`Sidecar write failed for ${path}: ${e}`, 'warn');
  }
  // -- Coalesced, serialised sidecar writes (rating/flag/favorite) -------------------------------
  // The UI already updates optimistically; the disk write is trailing-debounced per path so a
  // burst of keypresses on one photo (1..5, X/P, held key) costs ONE XMP rewrite carrying the
  // latest state. Every caller's promise resolves with that single write's outcome. A failure
  // rolls state back to the value BEFORE the first coalesced change. `immediate` (cull
  // decisions, one per photo) sends now. Pending writes flush on pagehide/blur/hide and before
  // any recipe write to the same path (see the invoke wrapper in head.part).
  const SIDECAR_DEBOUNCE_MS = 200;
  const sidecarPending = new Map(), sidecarInflight = new Map();
  function sidecarRepaint(path, skipCounts) {
    const sc = state.sidecars.get(path) || { rating: 0, label: '', edited: false };
    qlBadgesRefresh(path);
    const card = grid && grid.querySelector(`.lib-card[data-path="${CSS.escape(path)}"]`);
    if (card) {
      const flags = card.querySelector('.lib-flags');
      if (flags) flags.innerHTML = flagsHtml(sc.label, sc.favorite, sc.color_label);
      // HANDOVER section 8 item 12: keep the lbl-red/lbl-green class in step (the .lbl-red rule dims a
      // rejected thumbnail; it only applied after a full renderGrid() rebuilt card.className).
      card.classList.remove('lbl-red', 'lbl-green');
      if (sc.label === 'Red') card.classList.add('lbl-red');
      else if (sc.label === 'Green') card.classList.add('lbl-green');
      const holder = card.querySelector('.lib-stars');
      if (holder) holder.outerHTML = starsHtml(sc.rating || 0);
    }
    if (!skipCounts && typeof renderCollectionCounts === 'function') renderCollectionCounts(); // flagged/rejected counts changed
    // E5 fix (editor_ux_spec.json, 2026-09-09): setLabel/setRating/setFavorite are the ONE
    // canonical write path every flag UI funnels through; tell the Editor's topbar flag buttons
    // (fxUpdateFlagBtns, chromasmith-22.html) to re-read state so flagging the CURRENTLY OPEN photo
    // from anywhere in the Library never leaves the topbar stale.
    if (path === state.openedPath && typeof window.fxUpdateFlagBtns === 'function') window.fxUpdateFlagBtns();
  }
  function sidecarSend(path, entry) {
    clearTimeout(entry.timer);
    if (sidecarPending.get(path) === entry) sidecarPending.delete(path);
    const prior = sidecarInflight.get(path) || Promise.resolve();
    const run = prior.then(() => {
      const sc = state.sidecars.get(path) || { rating: 0, label: '', edited: false };
      return invoke('set_sidecar', { path, rating: sc.rating, label: sc.label, edited: sc.edited, favorite: sc.favorite })
        .then(() => true, (e) => { sidecarWriteFailed(path, entry.prev, e); sidecarRepaint(path); return false; });
    }).then((ok) => { entry.waiters.forEach((w) => w(ok)); if (sidecarInflight.get(path) === run) sidecarInflight.delete(path); });
    sidecarInflight.set(path, run);
    return run;
  }
  function sidecarWriteSoon(path, prev, immediate) {
    return new Promise((resolve) => {
      let e = sidecarPending.get(path);
      if (!e) { e = { prev, waiters: [], timer: 0 }; sidecarPending.set(path, e); }
      e.waiters.push(resolve);
      clearTimeout(e.timer);
      if (immediate) sidecarSend(path, e); else e.timer = setTimeout(() => sidecarSend(path, e), SIDECAR_DEBOUNCE_MS);
    });
  }
  function sidecarFlushPath(path) { const e = sidecarPending.get(path); if (e) sidecarSend(path, e); }
  function sidecarFlushAll() { for (const [p, e] of [...sidecarPending]) sidecarSend(p, e); }
  window.__sidecarFlushAll = sidecarFlushAll;
  window.addEventListener('pagehide', sidecarFlushAll);
  window.addEventListener('beforeunload', sidecarFlushAll);
  window.addEventListener('blur', sidecarFlushAll);
  document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden') sidecarFlushAll(); });
  async function setLabel(path, label, opts) {
    // Never start from a made-up default: a never-loaded sidecar (cards past the first catalog page)
    // would otherwise write rating 0 / edited false over the real XMP values.
    const cur = state.sidecars.get(path) || await getSidecar(path);
    if ((cur.label || '') === (label || '')) return true; // no-op: no undo entry, no write, no repaint
    libMetaRecord({ kind: 'label', path, prev: cur.label || '' });
    const updated = { ...cur, label };
    state.sidecars.set(path, updated);
    sidecarRepaint(path);
    return sidecarWriteSoon(path, cur, opts && opts.immediate);
  }
  // L7: a flag/rating/favorite change on MANY photos is one `set_sidecar_batch` IPC carrying only the
  // changed field (Rust writes the XMPs on its bounded pool, updates the registries and the catalog
  // once) instead of one debounced `set_sidecar` per photo. One path / no-op stays on the per-photo
  // path above, unchanged. Optimistic UI + per-photo undo records + rollback match setLabel/setRating.
  async function setFieldBatch(paths, field, value) {
    const one = (p) => field === 'label' ? setLabel(p, value) : field === 'rating' ? setRating(p, value) : setFavorite(p, value);
    paths = [...new Set(paths)];
    if (paths.length < 2) return Promise.all(paths.map(one));
    // Never start from a made-up default: load anything not cached yet (a light catalog-seeded entry is fine — it carries these fields).
    const uncached = paths.filter((p) => !state.sidecars.has(p));
    if (uncached.length) await getSidecarsBatch(uncached);
    const norm = field === 'rating' ? Math.max(0, Math.min(5, parseInt(value, 10) || 0)) : value;
    const cur = (p) => state.sidecars.get(p) || { rating: 0, label: '', edited: false };
    const same = (c) => field === 'label' ? (c.label || '') === (norm || '') : field === 'rating' ? (c.rating || 0) === norm : !!c.favorite === !!norm;
    const changed = paths.filter((p) => !same(cur(p)));
    if (!changed.length) return true;
    // Anything still waiting in the per-photo debounce for these paths goes out first, so the batch can
    // send just this one field without dropping an earlier change.
    changed.forEach(sidecarFlushPath);
    await Promise.all(changed.map((p) => sidecarInflight.get(p)).filter(Boolean));
    const prevs = new Map();
    for (const p of changed) {
      const c = cur(p);
      prevs.set(p, c);
      libMetaRecord(field === 'label' ? { kind: 'label', path: p, prev: c.label || '' }
        : field === 'rating' ? { kind: 'rating', path: p, prev: c.rating || 0 }
        : { kind: 'favorite', path: p, prev: !!c.favorite });
      state.sidecars.set(p, { ...c, [field]: norm });
      sidecarRepaint(p, true);
    }
    if (typeof renderCollectionCounts === 'function') renderCollectionCounts(); // once for the whole batch
    let errs;
    try {
      const patch = field === 'label' ? { label: norm || '' } : field === 'rating' ? { rating: norm } : { favorite: !!norm };
      errs = await invoke('set_sidecar_batch', { paths: changed, patch });
    } catch (e) { errs = changed.map(() => String(e)); }
    let failed = 0;
    changed.forEach((p, i) => { if (errs && errs[i]) { failed++; sidecarWriteFailed(p, prevs.get(p), errs[i]); sidecarRepaint(p, true); } });
    if (failed && typeof renderCollectionCounts === 'function') renderCollectionCounts();
    return failed === 0;
  }
  const setLabelsBatch = (paths, label) => setFieldBatch(paths, 'label', label);
  const setRatingsBatch = (paths, n) => setFieldBatch(paths, 'rating', n);
  const setFavoritesBatch = (paths, fav) => setFieldBatch(paths, 'favorite', fav);
  async function setColorLabel(path, colorLabel, allowWhenHidden = false) {
    if (!COLOR_LABELS_ENABLED && !allowWhenHidden) return false;
    if (colorLabel !== '' && !COLOR_LABELS.includes(colorLabel)) return false;
    const cur = state.sidecars.get(path) || await getSidecar(path);
    const prev = cur.color_label || '';
    if (prev === colorLabel) return true;
    const updated = { ...cur, color_label: colorLabel };
    state.sidecars.set(path, updated); qlBadgesRefresh(path);
    let saved = true;
    await invoke('set_color_label', { path, colorLabel }).catch((e) => { saved = false; sidecarWriteFailed(path, cur, e); });
    if (!saved) return false;
    libMetaRecord({ kind: 'color_label', path, prev });
    const card = grid && grid.querySelector(`.lib-card[data-path="${CSS.escape(path)}"]`);
    if (card) {
      const flags = card.querySelector('.lib-flags');
      if (flags) flags.innerHTML = flagsHtml(updated.label, updated.favorite, updated.color_label);
    }
    if (path === state.openedPath && typeof window.fxUpdateColorLabelControl === 'function') window.fxUpdateColorLabelControl();
    if (state.colorLabelFilter !== 'all') applyCatalogFilterChange(); else renderGrid();
    return true;
  }
  // Mirrors setLabel() above but for the favorite heart — same optimistic-update +
  // sidecar-write + rollback pattern, kept separate since favorite is independent of
  // (and can coexist with) a Red/Green flag.
  async function setFavorite(path, favorite) {
    const cur = state.sidecars.get(path) || await getSidecar(path);
    if (!!cur.favorite === !!favorite) return true;
    libMetaRecord({ kind: 'favorite', path, prev: !!cur.favorite });
    state.sidecars.set(path, { ...cur, favorite });
    sidecarRepaint(path);
    return sidecarWriteSoon(path, cur, false);
  }
  // Exposed so the main editor toolbar (chromasmith-22.html's top bar) can flag the
  // CURRENTLY OPEN photo without needing the Library panel open — same underlying
  // setLabel() the grid's own flag icons and context menu use, so it stays in sync either way.
  window.chromasmithToggleFlag = async (label) => {
    const path = state.openedPath;
    if (!path) return;
    const cur = await getSidecar(path);
    await setLabel(path, cur.label === label ? '' : label);
  };
  window.chromasmithHasOpenedPhoto = () => !!state.openedPath;
  window.chromasmithOpenedColorLabel = () => (state.sidecars.get(state.openedPath) || {}).color_label || '';
  window.chromasmithColorLabelsEnabled = () => COLOR_LABELS_ENABLED;
  window.chromasmithSetColorLabel = (colorLabel) => state.openedPath ? setColorLabel(state.openedPath, colorLabel) : Promise.resolve(false);
  // A photo that reaches the Editor any other way (drag-drop, Open File) is not the Gallery photo
  // that was open before it — forget that one, or the topbar flag/favorite (and the export's
  // source-path lookups) kept acting on the previous Gallery photo. Called by loadFXImages
  // unless the load came through libLoadFX. Found by test/control_sweep.mjs triage.
  window.chromasmithForgetOpened = () => {
    if (!state.openedPath && !(state.openedPaths || []).length) return;
    state.openedPath = ''; state.openedPaths = [];
    window.chromasmithSourcePath = null;
    if (typeof syncLibFlagRow === 'function') syncLibFlagRow();
    if (typeof syncLibActionButtons === 'function') syncLibActionButtons();
  };
  window.chromasmithOpenedFlag = () => {
    const path = state.openedPath;
    return path ? (state.sidecars.get(path) || {}).label || '' : '';
  };
  // Same open-photo bridge as chromasmithToggleFlag/chromasmithOpenedFlag above, for the
  // favorite heart.
  window.chromasmithToggleFavorite = async () => {
    const path = state.openedPath;
    if (!path) return;
    const cur = await getSidecar(path);
    await setFavorite(path, !cur.favorite);
  };
  window.chromasmithOpenedFavorite = () => {
    const path = state.openedPath;
    return path ? !!(state.sidecars.get(path) || {}).favorite : false;
  };