      dlg.querySelector('#lib-offq-ignore').onclick = () => finish('ignore');
      dlg.onkeydown = (e) => { if (e.key === 'Escape') finish(null); };
      dlg.showModal();
    });
  }
  async function checkOfflineQueueOnReconnect() {
