        img.dataset.previewSource = wantDeveloped ? 'developed-raw' : isRawPath ? 'camera-preview' : 'image';
      }
      img.classList.add('loaded');
      const creativeEditsOmitted = wantDeveloped && !!reviewSidecar?.edited;
