  const qlNav = { timer: 0, idx: 0, entries: null };
  function qlNavCancel() { clearTimeout(qlNav.timer); qlNav.timer = 0; qlNav.entries = null; }
  function qlNavFlush() {
    const entry = qlNav.entries && qlNav.entries[qlNav.idx];
