# Python calibration environment (recreate from calib/requirements.txt)
.calibvenv/
__pycache__/
*.pyc
*.npy

# OS / editor cruft
.DS_Store

# .claude/: settings.local.json (personal permission history, some genuinely machine-specific
# paths) and worktrees/ stay local-only. settings.json now uses $CLAUDE_PROJECT_DIR for every
# hook path (no machine-specific paths left in it) and is committed alongside the hook scripts it
# wires up — skills/agents/hooks are project knowledge meant to ship with the repo (see
# https://code.claude.com/docs/en/skills — "every teammate who clones the repo gets the skill"),
# and settings.json without those hooks actually wired is just as much a gap as the scripts alone.
.claude/*
.claude/.DS_Store
.claude/.explore-nudge-count
.claude/last-compact-snapshot.md
!.claude/skills/
!.claude/agents/
!.claude/hooks/
!.claude/settings.json

# Large or regenerable calibration assets (you supply your own captures):
# original RAW/JPEG/TIFF captures + the validation/proof renders the scripts emit
*.RW2
*.RAW
*.rw2
*.raw
*.dng
*.tif
*.tiff
*.ARW
*.arw
*.pp3
*.JPG
*.jpg
*.jpeg
calib/fujify/_*.png
calib/cmp_*.png
calib/val_*.png

# Grain calibration source renders (large; regenerate the chart with gen_grain_chart.py and
# re-render through Dehancer per calib/calibrate_grain_formats.py). Not bundled.
grain-test-2x.png
dehancer-*mm-*.png
dehancer-baseline-*.png

# Untracked source-material folder (not part of the public repo)
Fujify Luts and XMP/

# Dehancer extraction working files (local reference only, not redistributed —
# see calib/dehancer_probe.py / dehancer_extract_films.py)
calib/dehancer/

# nr_validate.py's dump_rw2 output cache (CS_DUMP_DIR default) — regenerate with dump_rw2, not
# meant to be committed.
calib/nr_dump/

# iOS shell (Capacitor): www/ is staged by build-ios.sh; node_modules restored by npm ci.
# The ios/ project IS committed (ios/.gitignore covers its build products/Pods/public).
node_modules/
www/

# macOS desktop shell (Tauri): desktop/dist/ is staged by build-desktop.sh; Rust build
# artifacts (target/, can be multiple GB) are never committed, only source + config.
desktop/dist/
desktop/src-tauri/target/

# SAM 2.1 Hiera-Tiny ONNX models (Phase 3 AI-select quality upgrade): encoder.onnx is ~134MB,
# over GitHub's 100MB hard push limit (no Git LFS set up for this repo) — see
# desktop/src-tauri/vendor/sam2/README.md for the exact download commands to re-fetch these.
desktop/src-tauri/vendor/sam2/*.onnx
# RawNIND UtNet2 raw denoiser (GPL-3.0 weights — see vendor/rawdenoise/README.md): ~30MB each,
# re-fetched from the darktable-ai release rather than committed, same rationale as sam2/ above.
desktop/src-tauri/vendor/rawdenoise/*.onnx
test/output/

# Personal photo-editing sidecars from using Chromasmith on your own photos with the repo as
# cwd — not app source, not meant for the public repo. (Doesn't untrack the handful of .xmp/
# .rrdata files already committed; only stops new ones from showing as untracked clutter and
# from being swept up by a broad `git add`.)
*.xmp
*.rrdata
Best/
Lucifer/
geneva/
IMG_5774_2x.PNG
IMG_7522.jxl
bloom-test-2x.png
Firefly_remove\ background*
calib/bloom_chart_geo.txt
*.PRE-FIX.bak
Chromasmith\ copy.app

# ── Product page (site/) ────────────────────────────────────────────────────────────────────
# Your full-size originals stay out of git; only the optimised WebP in site/assets/ is committed.
site/photos-src/
# *.jpg / *.jpeg / *.JPG are excluded globally above, which would silently drop a JPEG dropped
# into the built assets. The pipeline emits WebP, but keep the exception explicit so a stray file
# fails loudly (untracked-and-visible) rather than quietly.
# ⚠️ Negate by EXTENSION, not `!site/assets/**` — gitignore is last-match-wins, so a blanket
# negation here also un-ignores .DS_Store (line 8) inside site/assets/.
!site/assets/**/*.webp
!site/assets/**/*.png
!site/assets/**/*.jpg
!site/assets/manifest.json

diagnostics/reports/
diagnostics/baseline.json
.diagvenv/

# @playwright/test artifacts (behaviour suite) — traces/screenshots from failing runs
test-results/
playwright-report/

# Full-size layout-matrix screenshots (docs/ui-workflow/STATE.md, surface_capture.mjs) —
# content-addressed by hash, one file per DISTINCT image (state/theme/width/sidebar combos that
# render identically share a file), but the matrix is thousands of images per surface group.
# Only the generated contact-sheet grids + spec.json (design/asbuilt/) are committed.
design/asbuilt-full/
